<Project Sdk="Microsoft.NET.Sdk">
  <!-- GPT-5, 2026-08-05：将测试保持为轻依赖可执行程序，使其无需 Avalonia 桌面会话即可运行。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Gemini 4 Hydrogen, 2026-11-27：批次 46——改为按目录通配符引入全部 Core/Localization/CLI/测试源码，仅显式排除依赖 Avalonia 窗口系统的 SystemIntegrationService，防止新增核心服务时遗漏编译项触发 CS0246。 -->
  <ItemGroup>
    <Compile Include="Program*.cs" />
    <Compile Include="..\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="..\Core\**\bin\**\*.cs;..\Core\**\obj\**\*.cs;..\Core\Services\SystemIntegrationService.cs" />
    <Compile Include="..\Localization\*.cs" Link="Localization\%(Filename)%(Extension)" />
    <Compile Include="..\CommandLineHandler*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="..\HeadlessBatchRunner.cs" Link="HeadlessBatchRunner.cs" />
    <Compile Include="..\WindowsConsoleBootstrap.cs" Link="WindowsConsoleBootstrap.cs" />
    <Compile Include="..\ViewModels\TabVisibility.cs" Link="ViewModels\TabVisibility.cs" />
    <Compile Include="..\ViewModels\OperationCompletionSignal.cs" Link="ViewModels\OperationCompletionSignal.cs" />
    <Compile Include="..\ViewModels\DeleteSourceConfirmationGuard.cs" Link="ViewModels\DeleteSourceConfirmationGuard.cs" />
    <Compile Include="..\ViewModels\LogSearchFilter.cs" Link="ViewModels\LogSearchFilter.cs" />
    <Compile Include="..\ViewModels\FailedItemRetryList.cs" Link="ViewModels\FailedItemRetryList.cs" />
    <Compile Include="..\ViewModels\LogBuffer.cs" Link="ViewModels\LogBuffer.cs" />
    <EmbeddedResource Include="..\Localization\Resources\*.json">
      <Link>Localization\Resources\%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

  <!-- WorkBuddy, 2026-11-16：0.8.14——.NET 11 已自动提供 Logging.Abstractions，
       显式 PackageReference 会触发 NU1510；移除后由主工程引用传递编译资产。 -->

  <!-- GPT-5, 2026-08-06：macOS 回归测试使用项目内官方 7zz，不依赖机器全局安装。 -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="..\tools\7zip\macos\7zz" Link="tools\7zip\macos\7zz" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
